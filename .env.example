# 0G Sign - Environment Configuration
# Copy this to .env.local and fill in your values

# Default chain (used for initial wagmi config)
# Set to 16601 for testnet, 16661 for mainnet
# The app auto-detects the wallet's actual chain at upload time
NEXT_PUBLIC_OG_CHAIN_ID=16661

# Optional: server-side private key for API fallback mode (localStorage)
# OG_PRIVATE_KEY=0x_your_private_key_here
# OG_INDEXER_URL=https://indexer-storage-turbo.0g.ai
# OG_RPC_URL=https://evmrpc.0g.ai
